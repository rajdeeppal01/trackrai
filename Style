:root {
  --bg-dark: #0a0d0f;
  --bg-panel: #0f1417;
  --bg-raised: #131a1e;
  --border-slate: #223038;
  --border-slate-strong: #33454f;
  --primary-green: #4ade9c;
  --primary-green-dim: #2f8a63;
  --text-main: #d7e0e2;
  --text-dim: #6d7f86;
  --text-faint: #47585f;

  --c-applied: #6fa8d8;
  --c-oa: #e0b04c;
  --c-interview: #b394f0;
  --c-offer: #4ade9c;
  --c-rejected: #e0715f;

  --mono: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  background: var(--bg-dark);
  color: var(--text-main);
  font-family: var(--mono);
  font-size: 14px;
}

body {
  min-height: 100vh;
  padding: 24px 16px 60px;
  display: flex;
  justify-content: center;
}

.scanlines {
  position: fixed;
  inset: 0;
  pointer-events: none;
  background: repeating-linear-gradient(
    to bottom,
    rgba(255,255,255,0.014) 0px,
    rgba(255,255,255,0.014) 1px,
    transparent 1px,
    transparent 3px
  );
  z-index: 50;
}

.crt {
  width: 100%;
  max-width: 880px;
  border: 1px solid var(--border-slate-strong);
  border-radius: 8px;
  background: var(--bg-panel);
  box-shadow: 0 0 0 1px rgba(0,0,0,0.4), 0 20px 60px rgba(0,0,0,0.5);
  overflow: hidden;
}

/* ---------- title bar ---------- */

.termbar {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  background: var(--bg-raised);
  border-bottom: 1px solid var(--border-slate);
}

.termbar-dots { display: flex; gap: 6px; }
.dot { width: 10px; height: 10px; border-radius: 50%; opacity: 0.85; }
.dot-r { background: #e0715f; }
.dot-y { background: #e0b04c; }
.dot-g { background: #4ade9c; }

.termbar-title {
  flex: 1;
  text-align: center;
  font-size: 12px;
  color: var(--text-dim);
  letter-spacing: 0.02em;
}

.termbar-clock {
  font-size: 12px;
  color: var(--text-faint);
  min-width: 64px;
  text-align: right;
}

/* ---------- body ---------- */

.term-body {
  padding: 20px 22px 16px;
}

.boot-line {
  margin-bottom: 20px;
}
.boot-line p { margin: 0; font-size: 14px; }
.prompt { color: var(--primary-green); }
.colon { color: var(--text-faint); }
.path { color: var(--c-applied); }

.cursor-blink {
  color: var(--primary-green);
  animation: blink 1.1s steps(1) infinite;
}
@keyframes blink { 50% { opacity: 0; } }

/* ---------- stat strip ---------- */

.stat-strip {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 18px;
}

.stat-chip {
  border: 1px solid var(--border-slate);
  background: var(--bg-raised);
  border-radius: 4px;
  padding: 6px 12px;
  font-size: 12px;
  color: var(--text-dim);
  display: flex;
  gap: 6px;
  align-items: baseline;
}
.stat-chip b { color: var(--text-main); font-weight: 700; font-size: 13px; }
.stat-chip.accent { border-color: var(--primary-green-dim); }
.stat-chip.accent b { color: var(--primary-green); }

/* ---------- command row / filters ---------- */

.cmd-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 18px;
}

.filters {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.filter-tag {
  font-family: var(--mono);
  font-size: 12px;
  padding: 5px 10px;
  border: 1px solid var(--border-slate);
  background: transparent;
  color: var(--text-dim);
  border-radius: 4px;
  cursor: pointer;
}
.filter-tag:hover { border-color: var(--border-slate-strong); color: var(--text-main); }
.filter-tag.active {
  border-color: var(--primary-green-dim);
  color: var(--primary-green);
  background: rgba(74, 222, 156, 0.06);
}

.btn {
  font-family: var(--mono);
  font-size: 12px;
  padding: 8px 14px;
  border: 1px solid var(--border-slate);
  background: var(--bg-raised);
  color: var(--text-main);
  border-radius: 4px;
  cursor: pointer;
}
.btn:hover { border-color: var(--border-slate-strong); }
.btn:active { transform: scale(0.98); }
.btn-accent {
  border-color: var(--primary-green-dim);
  color: var(--primary-green);
}
.btn-accent:hover { background: rgba(74, 222, 156, 0.08); }
.btn-glyph { color: var(--primary-green); margin-right: 2px; }

/* ---------- form panel ---------- */

.form-panel {
  border: 1px solid var(--border-slate);
  border-radius: 6px;
  margin-bottom: 20px;
  overflow: hidden;
  background: var(--bg-dark);
}

.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 14px;
  background: var(--bg-raised);
  border-bottom: 1px solid var(--border-slate);
  font-size: 12px;
  color: var(--text-dim);
}

.panel-close {
  background: none;
  border: none;
  color: var(--text-dim);
  cursor: pointer;
  font-family: var(--mono);
  font-size: 13px;
}
.panel-close:hover { color: var(--c-rejected); }

.panel-body { padding: 16px; display: flex; flex-direction: column; gap: 12px; }

.field-row { display: flex; flex-direction: column; gap: 5px; }
.field-row.split { flex-direction: row; gap: 14px; }
.field-row.split > div { flex: 1; display: flex; flex-direction: column; gap: 5px; }

label {
  font-size: 11px;
  color: var(--text-dim);
  text-transform: lowercase;
  letter-spacing: 0.03em;
}
label .optional { color: var(--text-faint); }

input, select, textarea {
  font-family: var(--mono);
  font-size: 13px;
  background: var(--bg-panel);
  border: 1px solid var(--border-slate);
  color: var(--text-main);
  border-radius: 4px;
  padding: 8px 10px;
  outline: none;
}
input::placeholder, textarea::placeholder { color: var(--text-faint); }
input:focus, select:focus, textarea:focus {
  border-color: var(--primary-green-dim);
  box-shadow: 0 0 0 1px var(--primary-green-dim);
}
textarea { min-height: 64px; resize: vertical; }

.panel-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  padding-top: 4px;
}

/* ---------- table ---------- */

.table-wrap {
  border: 1px solid var(--border-slate);
  border-radius: 6px;
  overflow: hidden;
  margin-bottom: 18px;
}

.table-head {
  display: grid;
  grid-template-columns: 1.4fr 1.4fr 1fr 0.9fr 60px;
  gap: 8px;
  padding: 9px 14px;
  background: var(--bg-raised);
  border-bottom: 1px solid var(--border-slate);
  font-size: 11px;
  color: var(--text-faint);
  text-transform: lowercase;
  letter-spacing: 0.04em;
}

.table-body { display: flex; flex-direction: column; }

.row {
  display: grid;
  grid-template-columns: 1.4fr 1.4fr 1fr 0.9fr 60px;
  gap: 8px;
  padding: 11px 14px;
  border-bottom: 1px solid var(--border-slate);
  align-items: center;
  font-size: 13px;
  cursor: pointer;
}
.row:last-child { border-bottom: none; }
.row:hover { background: rgba(255,255,255,0.015); }

.row .col-company { color: var(--text-main); font-weight: 500; }
.row .col-role { color: var(--text-dim); }
.row .col-date { color: var(--text-faint); font-size: 12px; }

.tag {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 11px;
  padding: 3px 8px;
  border-radius: 3px;
  border: 1px solid transparent;
  width: fit-content;
}
.tag::before { content: '●'; font-size: 8px; }

.tag-applied { color: var(--c-applied); border-color: color-mix(in srgb, var(--c-applied) 40%, transparent); background: color-mix(in srgb, var(--c-applied) 10%, transparent); }
.tag-oa { color: var(--c-oa); border-color: color-mix(in srgb, var(--c-oa) 40%, transparent); background: color-mix(in srgb, var(--c-oa) 10%, transparent); }
.tag-interview { color: var(--c-interview); border-color: color-mix(in srgb, var(--c-interview) 40%, transparent); background: color-mix(in srgb, var(--c-interview) 10%, transparent); }
.tag-offer { color: var(--c-offer); border-color: color-mix(in srgb, var(--c-offer) 40%, transparent); background: color-mix(in srgb, var(--c-offer) 10%, transparent); }
.tag-rejected { color: var(--c-rejected); border-color: color-mix(in srgb, var(--c-rejected) 40%, transparent); background: color-mix(in srgb, var(--c-rejected) 10%, transparent); }

.row-del {
  background: none;
  border: none;
  color: var(--text-faint);
  cursor: pointer;
  font-family: var(--mono);
  font-size: 13px;
  justify-self: end;
}
.row-del:hover { color: var(--c-rejected); }

.empty-state {
  padding: 30px 14px;
  font-size: 13px;
  line-height: 1.8;
  margin: 0;
}
.dim { color: var(--text-faint); }

/* ---------- detail panel ---------- */

.detail-panel {
  border: 1px solid var(--border-slate);
  border-radius: 6px;
  margin-bottom: 18px;
  background: var(--bg-dark);
  padding: 16px;
  font-size: 13px;
}
.detail-panel h3 { margin: 0 0 10px; font-size: 14px; color: var(--text-main); font-weight: 500; }
.detail-panel .drow { display: flex; gap: 8px; margin-bottom: 6px; color: var(--text-dim); }
.detail-panel .drow b { color: var(--text-main); font-weight: 500; min-width: 70px; }
.detail-panel a { color: var(--c-applied); }
.detail-panel select { margin-top: 8px; }

/* ---------- footer ---------- */

.term-footer {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: var(--text-faint);
  padding-top: 4px;
}

/* ---------- responsive ---------- */

@media (max-width: 640px) {
  .term-body { padding: 16px 14px 14px; }
  .table-head { display: none; }
  .row {
    grid-template-columns: 1fr;
    gap: 4px;
    padding: 12px 14px;
  }
  .row .col-actions { justify-self: start; }
  .field-row.split { flex-direction: column; }
  .cmd-row { flex-direction: column; align-items: stretch; }
  .btn { width: 100%; }
}

@media (prefers-reduced-motion: reduce) {
  .cursor-blink { animation: none; }
}
