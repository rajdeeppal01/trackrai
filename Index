<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>~/applications — tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>

<div class="scanlines" aria-hidden="true"></div>

<div class="crt">

  <header class="termbar">
    <div class="termbar-dots">
      <span class="dot dot-r"></span><span class="dot dot-y"></span><span class="dot dot-g"></span>
    </div>
    <div class="termbar-title">rajdeep@applications — bash — 120×32</div>
    <div class="termbar-clock" id="clock">--:--:--</div>
  </header>

  <main class="term-body">

    <section class="boot-line">
      <p><span class="prompt">rajdeep@tracker</span><span class="colon">:</span><span class="path">~</span><span class="colon">$</span> ./track --list <span class="cursor-blink">▌</span></p>
    </section>

    <section class="stat-strip" id="statStrip" aria-label="application summary"></section>

    <section class="cmd-row">
      <div class="filters" id="filters" role="tablist" aria-label="filter by status"></div>
      <button class="btn btn-accent" id="addBtn">
        <span class="btn-glyph">+</span> new_application
      </button>
    </section>

    <section class="form-panel" id="formPanel" hidden>
      <div class="panel-head">
        <span>./new_application.sh</span>
        <button class="panel-close" id="closeForm" aria-label="close form">✕</button>
      </div>
      <div class="panel-body">
        <div class="field-row">
          <label for="f-company">company</label>
          <input id="f-company" type="text" placeholder="acme corp" autocomplete="off">
        </div>
        <div class="field-row">
          <label for="f-role">role</label>
          <input id="f-role" type="text" placeholder="swe intern" autocomplete="off">
        </div>
        <div class="field-row split">
          <div>
            <label for="f-status">status</label>
            <select id="f-status">
              <option value="applied">applied</option>
              <option value="oa">assessment</option>
              <option value="interview">interview</option>
              <option value="offer">offer</option>
              <option value="rejected">rejected</option>
            </select>
          </div>
          <div>
            <label for="f-date">date</label>
            <input id="f-date" type="date">
          </div>
        </div>
        <div class="field-row">
          <label for="f-link">link <span class="optional">optional</span></label>
          <input id="f-link" type="text" placeholder="https://..." autocomplete="off">
        </div>
        <div class="field-row">
          <label for="f-notes">notes <span class="optional">optional</span></label>
          <textarea id="f-notes" placeholder="referral from...; recruiter said..."></textarea>
        </div>
        <div class="panel-actions">
          <button class="btn" id="cancelBtn">cancel</button>
          <button class="btn btn-accent" id="saveBtn">save_entry</button>
        </div>
      </div>
    </section>

    <section class="table-wrap">
      <div class="table-head">
        <span class="col col-company">company</span>
        <span class="col col-role">role</span>
        <span class="col col-status">status</span>
        <span class="col col-date">date</span>
        <span class="col col-actions"></span>
      </div>
      <div class="table-body" id="tableBody"></div>
      <p class="empty-state" id="emptyState" hidden>
        <span class="prompt">$</span> ls applications/<br>
        <span class="dim">total 0 — nothing tracked yet. run ./track --new to add your first entry.</span>
      </p>
    </section>

    <section class="detail-panel" id="detailPanel" hidden></section>

    <footer class="term-footer">
      <span id="footerCount">0 entries</span>
      <span class="dim">stored locally in this browser</span>
    </footer>

  </main>
</div>

<script src="script.js"></script>
</body>
</html>
