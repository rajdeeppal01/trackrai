{
  "manifest_version": 3,
  "name": "TrackrAI Job Clipper",
  "version": "1.0.0",
  "description": "1-Click save jobs from LinkedIn and Indeed to your TrackrAI dashboard.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://trackrai-api.onrender.com/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*", "https://*.indeed.com/*"],
      "js": ["content.js"]
    }
  ]
}
